# Copy this file to `.env.local` and adjust if needed. All values are optional.

# Backend API base URL. Default: /api/v1 (proxied to http://127.0.0.1:3000 by `npm run dev`).
# In production, either serve the API on the same domain under /api, or set the full URL:
# VITE_API_URL=https://api.example.com/api/v1
VITE_API_URL=

# Set to true to run the UI with in-memory sample data and no backend (nothing is saved).
VITE_DEMO=false

# Name shown in the header and the browser tab.
VITE_CLUB_NAME=Lớp Cầu Lông
