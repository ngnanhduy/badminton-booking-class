# Copy to `.env` — or run `npm run keys:generate -w backend` to create it with fresh keys.
# NEVER commit `.env`: it contains the keys that protect students' personal data.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL connection string. Leave empty to use the embedded PostgreSQL (PGlite)
# stored in ./data/pglite — good for local development, no install needed.
# Supabase: Dashboard → Connect → "Session pooler" (works over IPv4), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# (URL-encode special characters in the password, e.g. @ → %40.)
# Local: postgres://booking:<password>@localhost:5432/booking
DATABASE_URL=

# TLS to the database: auto (off for localhost, on for remote) | disable | require | verify.
# verify = also check the server certificate against DATABASE_CA_CERT (recommended for
# Supabase: Dashboard → Database → Settings → SSL Configuration → Download certificate).
DATABASE_SSL=auto
# PEM text or path to the CA certificate file (used with DATABASE_SSL=verify).
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

# Folder with the built frontend to serve from the API (set automatically in Docker).
STATIC_DIR=

# Allowed browser origins for the API (comma separated).
CORS_ORIGINS=http://localhost:5173

# --- Encryption (base64, 32 bytes each). Generate with: npm run keys:generate -w backend ---
# AES-256-GCM key for personal data (name, phone/email, notes).
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=1
# Old keys kept only to decrypt data during key rotation, e.g. "1:BASE64KEY,2:BASE64KEY".
ENCRYPTION_OLD_KEYS=
# HMAC-SHA256 key for lookup indexes (find a booking by phone/email without decrypting).
BLIND_INDEX_KEY=

# Bearer token for /api/v1/admin/* (at least 32 characters). Empty = admin API disabled.
ADMIN_TOKEN=

# Personal data retention: bookings older than this are deleted automatically.
RETENTION_DAYS=180
# Version of the privacy notice users consent to (shown in the app, stored with each consent).
PRIVACY_POLICY_VERSION=2026-11-10
# Data controller shown in the privacy notice.
CONTROLLER_NAME=Lớp Cầu Lông
CONTROLLER_CONTACT=

# Set to true when running behind a reverse proxy (correct client IPs for rate limiting).
TRUST_PROXY=false

# --- Admin sign-in (email + password, /dang-nhap) ---
# Create the first admin with: npm run admin:create -w backend -- --email you@example.com --name "You"
# The address people open in the browser (dev: the Vite server; Docker: http://localhost:3000;
# production: https://<your-app>.onrender.com or your domain). https → Secure session cookies.
PUBLIC_URL=http://localhost:5173
# How long an admin stays signed in.
SESSION_TTL_HOURS=72
